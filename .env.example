# Configuración del Puerto
PORT=4000
PORT_CEDULAS=4100

# Configuración de Base de Datos MySQL
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=puntogob_db

# Configuración de Base de Datos SQL Server (alternativa)
# Descomentar estas líneas si usas SQL Server en lugar de MySQL
# DB_TYPE=mssql
# DB_HOST=localhost
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=your_sqlserver_password
# DB_NAME=puntogob_db

# Configuración de Email (Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=gobagendatucita@gmail.com

# EmailJS (para el frontend)
# Obtener de: https://www.emailjs.com/
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Configuración de Sesión y JWT
SESSION_SECRET=your_random_secret_key_here_change_in_production
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Modo de Desarrollo
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# API Base URL (para el frontend)
VITE_API_URL=http://localhost:4000/api
VITE_API_CEDULAS_URL=http://localhost:4100/api
